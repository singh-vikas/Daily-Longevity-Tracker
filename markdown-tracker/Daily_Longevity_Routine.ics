BEGIN:VEVENT
UID:circadian-reset@longevity-tracker
DTSTART;TZID=America/Los_Angeles:20240101T060000
DTEND;TZID=America/Los_Angeles:20240101T063000
RRULE:FREQ=DAILY;INTERVAL=1
SUMMARY:🌅 Circadian Reset & Activation Block
DESCRIPTION:Immediate Upon Waking:\n- No phone/screens (preserve dopamine baseline)\n- Get out of bed immediately (avoid snoozing)\n- Morning sunlight exposure (5-10 min outdoors)\n\nHydration & Gut Activation:\n- Warm water with fresh lime (500ml)\n- Optional: 1 tbsp apple cider vinegar\n- No caffeine yet (wait 90-120 min)\n\nMindfulness & Stress Reduction:\n- Meditation or pranayama (10-15 min)\n- Box breathing or Anulom-Vilom
LOCATION:Home
BEGIN:VALARM
TRIGGER:-PT5M
ACTION:DISPLAY
DESCRIPTION:Circadian Reset & Activation Block starting in 5 minutes
END:VALARM
END:VEVENT

BEGIN:VEVENT
UID:exercise-block@longevity-tracker
DTSTART;TZID=America/Los_Angeles:20240101T063000
DTEND;TZID=America/Los_Angeles:20240101T073000
RRULE:FREQ=DAILY;INTERVAL=1
SUMMARY:🏋️ Exercise & Performance Block (60 min)
DESCRIPTION:Pre-Workout Prep (10 min):\n- Transition time (5 min)\n- L-Tyrosine (500mg) - optional\n- Light hydration (200-300ml)\n- Mental preparation\n\nWorkout Session (40 min):\nChoose ONE per day:\n- Strength Training (3-4 exercises, 3-4 sets, 8-12 reps)\n- Zone 2 Cardio (30-40 min, 60-70% max HR)\n- Zone 5 Intervals (4-6 intervals)\n- Light/Recovery Day (flexibility & mobility)\n\nPost-Workout Cool-Down (10 min):\n- Wait 10-15 minutes before showering\n- Light stretching\n- Hydration
LOCATION:Home/Gym
BEGIN:VALARM
TRIGGER:-PT5M
ACTION:DISPLAY
DESCRIPTION:Exercise & Performance Block starting in 5 minutes
END:VALARM
END:VEVENT

